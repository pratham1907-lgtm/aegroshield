rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Mandi Rates & Market Data: Publicly readable for all farmers, but writes restricted to Admin/Backend SDK only
    match /mandi_rates/{document=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    // Mandi Sync Metadata: Publicly readable, write restricted to Admin
    match /mandi_metadata/{document=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    // User Data & Profiles: Users can only read & write their own records
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Default catch-all: Deny all other access unless explicitly allowed
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
