# ==============================================================================
# AegroShield Environment Variables Configuration (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Artificial Intelligence (Gemini AI API)
# ------------------------------------------------------------------------------
# Required for AgriShield AI Chatbot advisory and smart calculations
GEMINI_API_KEY=your_gemini_api_key

# ------------------------------------------------------------------------------
# 2. Administrative Credentials & Secrets
# ------------------------------------------------------------------------------
NEXT_PUBLIC_ADMIN_SECRET_KEY=aegroshield_admin_1907
ADMIN_SECRET_KEY=aegroshield_admin_1907

# ------------------------------------------------------------------------------
# 3. Supabase Configuration (PostgreSQL Database & Auth)
# ------------------------------------------------------------------------------
# PostgreSQL connection strings for Prisma ORM
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# Supabase Client & SSR Keys
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT_REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key
# Optional service role key for elevated backend operations
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ------------------------------------------------------------------------------
# 4. Firebase Authentication (Client & Server Admin SDK)
# ------------------------------------------------------------------------------
# Firebase Web Client Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Firebase Admin Service Account (Server-side token verification)
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your_project_id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------------------
# 5. Sentry Observability & Error Tracking
# ------------------------------------------------------------------------------
# Public DSN for browser/client-side error reporting
NEXT_PUBLIC_SENTRY_DSN=https://your_public_key@o0.ingest.sentry.io/your_project_id

# Server & Edge DSN for backend runtime monitoring
SENTRY_DSN=https://your_secret_key@o0.ingest.sentry.io/your_project_id

# Sentry CLI / Webpack plugin deployment configuration (for source map uploads)
SENTRY_ORG=your_sentry_org_slug
SENTRY_PROJECT=aegroshield
SENTRY_AUTH_TOKEN=sntrys_your_sentry_auth_token

# ------------------------------------------------------------------------------
# 6. Government Open Data (Agmarknet Mandi API)
# ------------------------------------------------------------------------------
# API Key for data.gov.in Mandi Price feeds
DATA_GOV_API_KEY=your_data_gov_api_key
DATA_GOV_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070

# ------------------------------------------------------------------------------
# 7. Scheduled Tasks & Automation
# ------------------------------------------------------------------------------
# Authorization secret for daily automated Mandi Sync endpoint (/api/mandi-sync)
CRON_SECRET=your_secure_cron_secret_key

# ------------------------------------------------------------------------------
# 8. SMS & WhatsApp Notification Gateways (Optional / Multi-Provider)
# ------------------------------------------------------------------------------
# Option A: Fast2SMS (India Quick SMS)
FAST2SMS_API_KEY=your_fast2sms_api_key

# Option B: MSG91 (India DLT Gateway)
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_SENDER_ID=AGRSHL

# Option C: Twilio (Global SMS)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_PHONE=+1234567890

# Option D: WhatsApp Webhook / Cloud API (AiSensy, Wati, Gupshup, Meta Graph API)
WHATSAPP_WEBHOOK_URL=https://api.yourwhatsappprovider.com/webhook/send

