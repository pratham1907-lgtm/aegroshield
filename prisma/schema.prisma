datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id          String   @id @default(cuid())
  firebaseUid String?  @unique
  email       String?
  name        String?
  phone       String?  @unique
  role        String   @default("FARMER")
  isDemo      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sellers     Seller[]
  machineries Machinery[]
  labourPosts LabourPost[]
  bookings    Booking[]
  orders      Order[]

  @@index([firebaseUid])
}

model Seller {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeName          String
  ownerName          String
  phone              String
  category           String?
  // Legacy combined field (kept for backward compat)
  licenseOrGstin     String?
  // Dedicated compliance fields
  gstin              String?  // GST Identification Number (15-char alphanumeric)
  licenseNumber      String?  // Insecticide Dealer Licence / State business licence
  documentUrl        String?  // URL to uploaded compliance document (cloud storage)
  verificationStatus String   @default("PENDING_VERIFICATION")
  state              String?  @default("Uttar Pradesh")
  district           String
  shopAddress        String?
  isVerified         Boolean  @default(false)
  isDemo             Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  products           Product[]
}

model Product {
  id          String   @id @default(cuid())
  sellerId    String
  seller      Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  name        String
  category    String
  price       Float
  unit        String
  stock       Int      @default(0)
  imageUrl    String?
  description String?
  isDemo      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Machinery {
  id           String   @id @default(cuid())
  ownerId      String
  owner        User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title        String
  machineType  String
  ratePerHour  Float
  state        String?  @default("Uttar Pradesh")
  district     String
  contactPhone String
  available    Boolean  @default(true)
  isDemo       Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  bookings     Booking[]
}

model LabourPost {
  id           String   @id @default(cuid())
  leaderId     String
  leader       User     @relation(fields: [leaderId], references: [id], onDelete: Cascade)
  leaderName   String
  groupSize    Int
  primarySkill String
  wagePerDay   Float
  state        String?  @default("Uttar Pradesh")
  district     String
  phone        String
  isDemo       Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  bookings     Booking[]
}

model Booking {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookingType   String // MACHINERY / LABOUR
  targetId      String?
  customerName  String?
  customerPhone String?
  itemTitle     String?
  district      String?
  startDate     DateTime?
  endDate       DateTime?
  duration      String? // e.g. "4 hours" or "3 days"
  machineryId   String?
  machinery     Machinery?  @relation(fields: [machineryId], references: [id], onDelete: SetNull)
  labourPostId  String?
  labourPost    LabourPost? @relation(fields: [labourPostId], references: [id], onDelete: SetNull)
  status        String      @default("PENDING")
  bookingDate   DateTime    @default(now())
  totalAmount   Float
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model Order {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  items           Json
  totalAmount     Float
  status          String   @default("PENDING")
  shippingAddress String
  customerName    String?
  customerPhone   String?
  district        String?
  pincode         String?
  paymentMethod   String   @default("Cash on Delivery (COD)")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
