datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id          String   @id @default(cuid())
  firebaseUid String?  @unique
  email       String?
  name        String?
  phone       String?
  role        String   @default("FARMER")
  isDemo      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sellers     Seller[]
  machineries Machinery[]
  labourPosts LabourPost[]
  bookings    Booking[]
  orders      Order[]

  @@index([firebaseUid])
}

model Seller {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeName      String
  ownerName      String
  phone          String
  licenseOrGstin String
  district       String
  shopAddress    String
  isVerified     Boolean  @default(false)
  isDemo         Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  products       Product[]
}

model Product {
  id          String   @id @default(cuid())
  sellerId    String
  seller      Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  name        String
  category    String
  price       Float
  unit        String
  stock       Int      @default(0)
  imageUrl    String?
  description String?
  isDemo      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Machinery {
  id           String   @id @default(cuid())
  ownerId      String
  owner        User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title        String
  machineType  String
  ratePerHour  Float
  district     String
  contactPhone String
  available    Boolean  @default(true)
  isDemo       Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model LabourPost {
  id           String   @id @default(cuid())
  leaderId     String
  leader       User     @relation(fields: [leaderId], references: [id], onDelete: Cascade)
  leaderName   String
  groupSize    Int
  primarySkill String
  wagePerDay   Float
  district     String
  phone        String
  isDemo       Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Booking {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookingType String // MACHINERY / LABOUR
  targetId    String
  status      String   @default("PENDING")
  bookingDate DateTime @default(now())
  totalAmount Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Order {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  items           Json
  totalAmount     Float
  status          String   @default("PENDING")
  shippingAddress String
  customerName    String?
  customerPhone   String?
  district        String?
  pincode         String?
  paymentMethod   String   @default("Cash on Delivery (COD)")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
